# Broker: paper | moomoo | webull
BROKER=paper
# Safety: live trading is refused unless this is exactly "yes"
ALLOW_LIVE=no
TRADE_ENV=SIMULATE

# Strategy
SYMBOLS=AAPL,MSFT
SMA_FAST=10
SMA_SLOW=30
ORDER_QTY=1
POLL_SECONDS=60

# Risk limits
MAX_POSITION_QTY=10
MAX_ORDERS_PER_DAY=20
MAX_DAILY_LOSS=200

# Monitoring API (the iOS app talks to this). Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=change-me
API_HOST=0.0.0.0
API_PORT=8000
DB_PATH=trading.db

# Moomoo (OpenD gateway must be running)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=
MOOMOO_MARKET=US

# Webull OpenAPI
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
