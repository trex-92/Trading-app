# Broker: paper | moomoo | webull
BROKER=paper
# Safety: live trading is refused unless this is exactly "yes"
ALLOW_LIVE=no
TRADE_ENV=SIMULATE

# Strategy
SYMBOLS=AAPL,MSFT
SMA_FAST=10
SMA_SLOW=30
ORDER_QTY=1
POLL_SECONDS=60

# Risk limits
MAX_POSITION_QTY=10
MAX_ORDERS_PER_DAY=20
MAX_DAILY_LOSS=200

# Supabase (bot writes with the service-role key; keep this file on the bot host only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=   # auth.users id of the app account that should see this bot
COMMAND_POLL_SECONDS=3
DB_PATH=trading.db

# Moomoo REST (BROKER=moomoo_rest): no OpenD. Run `python -m bot.moomoo_login` once; tokens go to
# MOOMOO_TOKEN_FILE (default ~/.config/trading-bot/moomoo_tokens.json, mode 0600), never in env vars.
MOOMOO_ACC_ID=            # optional; required for REAL if several accounts are authorized
MOOMOO_LIMIT_BUFFER_PCT=1   # orders go out as limits this % beyond last price (sim rejects plain market orders)
MOOMOO_SIM_MARKET=        # optional; market id sent with simulated orders (auto: 100 for the US sim account)

# Moomoo OpenD SDK (BROKER=moomoo; OpenD gateway must be running)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=
MOOMOO_MARKET=US

# Webull OpenAPI
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us

# Backtest worker (serves backtests requested from the app; needs BROKER=moomoo_rest for history)
BACKTEST_WORKER=yes
CALENDAR_FILE=data/calendar.json

# Strategy engine (A/B/C) on the SIMULATED account only. Stops are held by this bot, not the broker.
LIVE_STRATEGIES=no          # set to yes to start it (needs BROKER=moomoo_rest, TRADE_ENV=SIMULATE)
RUN_SMA_DEMO=no             # the old moving-average demo; turn off when LIVE_STRATEGIES=yes
RISK_PER_TRADE_PCT=1.0
RISK_HARD_CEILING_PCT=1.0   # the bot refuses to start if RISK_PER_TRADE_PCT is above this
DAILY_MAX_LOSS_PCT=2.0
MARKETS_FILE=data/markets.json   # optional per-market hours/lots/fees overrides
# STRATEGY_UNIVERSE is gone: choose markets and symbols in the app (Settings > Markets)
HISTORY_CACHE_DIR=data/cache   # finished days of 1-minute history are saved here so reruns do not hit Moomoo's rate limit
