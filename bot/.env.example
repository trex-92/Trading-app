# Broker: paper | moomoo | webull
BROKER=paper
# Safety: live trading is refused unless this is exactly "yes"
ALLOW_LIVE=no
TRADE_ENV=SIMULATE

# Strategy
SYMBOLS=AAPL,MSFT
SMA_FAST=10
SMA_SLOW=30
ORDER_QTY=1
POLL_SECONDS=60

# Risk limits
MAX_POSITION_QTY=10
MAX_ORDERS_PER_DAY=20
MAX_DAILY_LOSS=200

# Supabase (bot writes with the service-role key; keep this file on the bot host only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=   # auth.users id of the app account that should see this bot
COMMAND_POLL_SECONDS=3
DB_PATH=trading.db

# Moomoo (OpenD gateway must be running)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=
MOOMOO_MARKET=US

# Webull OpenAPI
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
